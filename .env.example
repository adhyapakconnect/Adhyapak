# Canonical site URL (no trailing slash). Used for metadata, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://adhyapakconnect.in

# Google Form for parent enquiries. Leave empty to send every
# "Book Free Demo" button to the free-demo call band (/#demo).
NEXT_PUBLIC_DEMO_FORM_URL=

# Review mode shows the "DEMO UI" banner and [CHECK] markers.
# Set to false once numbers/claims are confirmed.
NEXT_PUBLIC_REVIEW_MODE=true

# Analytics — each loads only when set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console HTML-tag verification code (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
